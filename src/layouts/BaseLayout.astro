---
import { ADSENSE_PUBLISHER_ID } from "../config/ads";
import { SITE_NAME, SITE_DESCRIPTION, ANALYTICS_SITE_ID, ANALYTICS_SCRIPT_SRC } from "../config/site";
import AdSlot from "../components/AdSlot.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  type?: "website" | "article";
  pubDate?: Date;
  ogImage?: string;
  /** Which top-level section this page belongs to, for nav highlighting. */
  section?: "home" | "blog" | "services" | "waitlist";
}

const {
  title,
  description = SITE_DESCRIPTION,
  type = "website",
  pubDate,
  ogImage,
  section = "home",
} = Astro.props;

// The conditional `noindex` that used to sit below is gone with the placeholder
// domain that triggered it: SITE_URL now defaults to the real domain, so there
// is no build that silently carries off-site canonicals and needs suppressing.
// A staging build that should not be indexed sets SITE_URL to its own hostname
// and is blocked at the host, not from here.
//
// Kept as a frontmatter comment deliberately: Astro renders template-level HTML
// comments into the shipped page, and this note is for whoever edits the file.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const resolvedOgImage = ogImage ? new URL(ogImage, Astro.site).toString() : new URL("/og-default.svg", Astro.site).toString();
const hasAdSense = /^ca-pub-\d+$/.test(ADSENSE_PUBLISHER_ID);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 16 16%22><text y=%2213%22 font-size=%2213%22>%E2%9A%99%EF%B8%8F</text></svg>" />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href={new URL("rss.xml", Astro.site)} />

    <!-- OpenGraph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:image" content={resolvedOgImage} />
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <!-- AdSense loader. Loaded async so it never blocks render. Publisher ID is a
         placeholder until src/config/ads.ts is updated with a real one. -->
    {hasAdSense && <script
      async
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_PUBLISHER_ID}`}
      crossorigin="anonymous"></script>}

    <!-- Privacy-respecting analytics. No-op until ANALYTICS_SITE_ID is set in
         src/config/site.ts — nothing loads or sends data before then. -->
    {ANALYTICS_SITE_ID && <script defer data-domain={ANALYTICS_SITE_ID} src={ANALYTICS_SCRIPT_SRC}></script>}
  </head>
  <body>
    <div class="site">
      <header class="site-header">
        <div class="site-header__brand">
          <a class="site-title" href="/">{SITE_NAME}</a>
          <nav class="site-nav" aria-label="Sections">
            <a href="/blog/" aria-current={section === "blog" ? "page" : undefined}>Blog</a>
            <a href="/services/" aria-current={section === "services" ? "page" : undefined}>Services</a>
            <a class="site-nav__cta" href="/waitlist/" aria-current={section === "waitlist" ? "page" : undefined}>Waitlist</a>
          </nav>
        </div>
        <p>Notes on compounding leverage - agentic dev harnesses, skills, unattended coding agents, and the self-teaching that keeps up with them.</p>
      </header>

      <div class="header-banner">
        <img
          src="/header-banner.svg"
          alt="Abstract cobalt, violet, and cyan light for A Lazy Engineer"
          width="1600"
          height="420"
          fetchpriority="high"
        />
      </div>

      <div class:list={["layout-grid", { "layout-grid--with-sidebar": hasAdSense }]}>
        <main>
          <slot />
        </main>
        {hasAdSense && <aside class="sidebar">
          <AdSlot slot="2222222222" format="rectangle" label="Sidebar" />
        </aside>}
      </div>

      <footer class="site-footer">
        <p>Written anonymously by a software engineer who spends too much time thinking about coding agents. No name, no employer, just the notes.</p>
        <p class="site-footer__links">
          <a href="/blog/">Blog</a>
          <a href="/services/">Services</a>
          <a href="/waitlist/">Waitlist</a>
          <a href="/rss.xml">RSS feed</a>
        </p>
      </footer>
    </div>
  </body>
</html>
