---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function excerpt(body: string, length = 220) {
  const plain = body
    .replace(/^---[\s\S]*?---/, "")
    .replace(/[#*`>_[\]()]/g, "")
    .replace(/\s+/g, " ")
    .trim();
  return plain.length > length ? `${plain.slice(0, length).trim()}…` : plain;
}
---

<BaseLayout title="Unattended Runs — notes on harness engineering">
  <h1 class="visually-hidden">Unattended Runs — notes on harness engineering</h1>
  <ul class="post-list">
    {
      posts.map((post) => (
        <li>
          <h2>
            <a href={`/${post.slug}/`}>{post.data.title}</a>
          </h2>
          <div class="post-meta">
            {post.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
          </div>
          <p>{post.data.description || excerpt(post.body)}</p>
          <div>
            {post.data.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </li>
      ))
    }
  </ul>
</BaseLayout>
