---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { SERVICE_BRANCHES } from "../../config/services";
import { PILLARS } from "../../config/pillars";
import { SITE_NAME } from "../../config/site";

export async function getStaticPaths() {
  return SERVICE_BRANCHES.map((branch) => ({
    params: { branch: branch.slug },
    props: { branch },
  }));
}

const { branch } = Astro.props;
const pillar = PILLARS.find((p) => p.tag === branch.relatedTag);
const relatedPosts = pillar
  ? (await getCollection("posts", ({ data }) => !data.draft && data.tags.includes(pillar.tag)))
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
      .slice(0, 3)
  : [];
---

<BaseLayout
  title={`${branch.label} services — ${SITE_NAME}`}
  description={branch.tagline}
  section="services"
>
  <p class="section-label">Services</p>
  <h1 class="page-title">{branch.label}</h1>
  <p class="lede">{branch.description}</p>

  {branch.offerings.map((offering) => (
    <section class="offering">
      <h2>{offering.title}</h2>
      <p class="offering__audience">{offering.audience}</p>
      <p>{offering.summary}</p>
      <h3>What you get</h3>
      <ul class="offering__list">
        {offering.deliverables.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </section>
  ))}

  {
    pillar && (
      <section class="related-posts" aria-labelledby="related-posts-heading">
        <p class="section-label">Proof in public</p>
        <h2 id="related-posts-heading">See the thinking before you enquire.</h2>
        <p class="related-posts__intro">
          This is the applied version of the blog's {pillar.label.toLowerCase()} pillar. Read a
          few of the working notes first, at no charge, then decide whether the service fits.
        </p>
        <ul class="related-posts__grid">
          {relatedPosts.map((post) => (
            <li>
              <a href={`/blog/${post.slug}/`}>
                <strong>{post.data.title}</strong>
                <span>{post.data.description}</span>
                <em>Read the note &rarr;</em>
              </a>
            </li>
          ))}
        </ul>
        <a class="read-more" href={`/blog/tags/${pillar.tag}/`}>See all {pillar.label.toLowerCase()} notes &rarr;</a>
      </section>
    )
  }

  <section class="cta-panel">
    <h2>Enquiring about {branch.label.toLowerCase()}</h2>
    <p>
      Two concurrent engagements at a time, enquiries reviewed in batches. Join the waitlist and
      say which of the above fits.
    </p>
    <a class="cta-panel__action" href="/waitlist/">Join the waitlist &rarr;</a>
  </section>

  <p><a class="back-link" href="/services/">&larr; All services</a></p>
</BaseLayout>
